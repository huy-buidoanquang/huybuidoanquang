---
import BaseLayout from '../layouts/BaseLayout.astro';
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import profile from '../data/profile.json';
import '../styles/experience.css';
const projects = await getCollection('projects');
const destinations = await getCollection('destinations');
const posts = (await getCollection('posts')).sort((a,b) => b.data.date.valueOf() - a.data.date.valueOf());
const displayName = profile.shortName === 'YOUR NAME' ? 'HELLO.' : profile.shortName;
---
<BaseLayout title="Portfolio × Journal">
    <main id="main" class="home">
        <div class="journey-backdrop" aria-hidden="true"><div class="cosmos-layer"></div><div class="nature-layer"></div></div>
        <section id="person" class="chapter hero-chapter" aria-labelledby="hero-title">
            {profile.portrait && <div class="hero-ambient" aria-hidden="true"><img src={profile.portrait} alt="" /></div>}
            {profile.portrait && <div class="hero-portrait"><img src={profile.portrait} alt={profile.portraitAlt} fetchpriority="high" decoding="async" /></div>}
            <div class="chapter-inner hero-inner">
                <div class="hero-topline"><span>01 / Điểm xuất phát</span><span>{profile.location} → bất cứ đâu</span></div>
                <p class="hero-kicker">Portfolio / Field notes<br />Một người, nhiều hành trình</p>
                <h1 id="hero-title">{displayName}</h1>
                <div class="hero-bottomline"><p>{profile.intro}</p><a href="#projects" class="scroll-arrow" aria-label="Cuộn tới dự án">↓</a><span>Cuộn để đi xuyên qua câu chuyện<br />Nhấn vào một điểm để khám phá</span></div>
            </div>
        </section>
        <section class="chapter about-chapter" aria-labelledby="about-title">
            <div class="chapter-inner about-inner"><span class="section-number">02 / Về tôi</span><h2 id="about-title">Hai thế giới.<br /><em>Một người kể.</em></h2><p>Từ một ý tưởng trên màn hình đến con đường chưa từng đi qua — tôi muốn giữ lại cả quá trình, không chỉ điểm đến.</p><a class="sky-credit" href="https://science.nasa.gov/image-detail/milkyway-desrt-tree-credit-preston-dyches-2/">Ảnh nền: NASA / Preston Dyches ↗</a></div>
        </section>
        <section id="projects" class="chapter projects-chapter" aria-labelledby="projects-title">
            <div class="chapter-inner"><div class="chapter-heading"><span class="section-number">03 / Những thứ tôi tạo ra</span><h2 id="projects-title">Made<br /><em>of curiosity.</em></h2></div>
                <div class="project-list">{projects.map((project,index) => <a class="project-row" href={'/projects/' + project.id + '/'}><span class="project-order">0{index+1}</span><strong>{project.data.title}</strong><span class="project-summary">{project.data.summary}</span><span class="project-arrow">↗</span><Image class="project-preview" src={project.data.cover} alt={project.data.coverAlt} widths={[480,960]} sizes="(max-width: 800px) 100vw, 35vw" loading="lazy" /></a>)}</div>
                <p class="sample-note">Dự án mẫu — thay nội dung trong GitHub.</p>
            </div>
        </section>
        <section id="journeys" class="chapter journeys-chapter" aria-labelledby="journeys-title">
            <div class="chapter-inner"><span class="section-number">04 / Ngoài màn hình</span><h2 id="journeys-title">Beyond<br /><em>coordinates.</em></h2><p>Đi qua một nơi là nhìn thấy nó đổi khác theo ánh sáng, con người và ký ức của chính mình.</p>
                <div class="destination-list">{destinations.map((place,index) => <a href={'/places/' + place.id + '/'} class="destination-link"><Image src={place.data.cover} alt={place.data.coverAlt} widths={[640,960,1440]} sizes="(max-width: 800px) 100vw, 84vw" loading="lazy" /><span><small>Điểm đến / 0{index+1}</small><strong>{place.data.title}</strong><b>Khám phá ↗</b></span></a>)}</div>
                <p class="sample-note">Địa điểm mẫu — thay ảnh và câu chuyện trong GitHub.</p>
            </div>
        </section>
        <section id="journal" class="chapter journal-chapter" aria-labelledby="journal-title">
            <div class="chapter-inner"><span class="section-number">05 / Nhật ký</span><h2 id="journal-title">Field<br /><em>notes.</em></h2><div class="journal-list">{posts.slice(0,3).map((post,index) => <a href={'/journal/' + post.id + '/'}><span>0{index+1}</span><strong>{post.data.title}</strong><span>{post.data.category.replace('-', ' ')}</span><b>↗</b></a>)}</div><a class="text-link" href="/journal/">Đọc tất cả bài viết ↗</a></div>
        </section>
    </main>
    <script>
        import { getNatureBlend } from '../journey/scrollProgress.js';
        const home = document.querySelector<HTMLElement>('.home');
        const cosmos = document.querySelector<HTMLElement>('.cosmos-layer');
        const nature = document.querySelector<HTMLElement>('.nature-layer');
        const portrait = document.querySelector<HTMLElement>('.hero-portrait');
        const journeys = document.querySelector<HTMLElement>('#journeys');
        let blend = 0;
        let scheduled = false;
        const update = () => {
            scheduled = false;
            if (!home || !cosmos || !nature || !journeys) return;
            blend = getNatureBlend(journeys.getBoundingClientRect().top, innerHeight);
            cosmos.style.opacity = String(1 - blend);
            nature.style.opacity = String(blend);
            if (!matchMedia('(prefers-reduced-motion: reduce)').matches) {
                cosmos.style.transform = `scale(1.12) translate3d(0,${Math.min(scrollY * -0.035, 0)}px,0)`;
                nature.style.transform = `scale(1.08) translate3d(0,${Math.max(-90, (journeys.getBoundingClientRect().top - innerHeight) * 0.035)}px,0)`;
                if (portrait) portrait.style.setProperty('--portrait-y', Math.min(scrollY * 0.12, 140) + 'px');
            }
        };
        const queueUpdate = () => {
            if (scheduled) return;
            scheduled = true;
            requestAnimationFrame(update);
        };
        home?.classList.add('journey-active');
        addEventListener('scroll', queueUpdate, { passive: true });
        addEventListener('resize', queueUpdate, { passive: true });
        addEventListener('pageshow', queueUpdate);
        update();
    </script>
</BaseLayout>
