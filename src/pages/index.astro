---
import BaseLayout from '../layouts/BaseLayout.astro';
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import profile from '../data/profile.json';
const projects = await getCollection('projects');
const destinations = await getCollection('destinations');
const posts = (await getCollection('posts')).sort((a,b) => b.data.date.valueOf() - a.data.date.valueOf());
---
<BaseLayout title="Portfolio × Journal">
    <main id="main" class="home">
        <div class="journey-backdrop" aria-hidden="true"></div>
        <canvas id="journey-canvas" class="journey-canvas" aria-hidden="true"></canvas>
        <section id="person" class="chapter hero-chapter" aria-labelledby="hero-title">
            <div class="chapter-inner hero-inner">
                <div class="hero-topline"><span>01 / Bắt đầu từ đây</span><span>{profile.location} ↗ Thế giới</span></div>
                <p class="hero-kicker">Một portfolio và những câu chuyện trên đường đi</p>
                <h1 id="hero-title"><span>HELLO</span><span class="outline">WORLD.</span></h1>
                <div class="hero-bottomline"><p>{profile.intro}</p><a href="#projects" class="circle-link" aria-label="Cuộn tới dự án">↓</a><span>Cuộn để khám phá<br />Chạm để đi sâu hơn</span></div>
            </div>
        </section>
        <section class="chapter about-chapter" aria-labelledby="about-title">
            <div class="chapter-inner about-inner"><span class="section-number">02 / Về tôi</span><h2 id="about-title">Luôn tò mò<br /><em>về phía trước.</em></h2><p>Một dự án bắt đầu bằng câu hỏi. Một chuyến đi bắt đầu bằng bước chân đầu tiên. Cả hai đều khiến tôi nhìn thế giới khác đi.</p></div>
        </section>
        <section id="projects" class="chapter projects-chapter" aria-labelledby="projects-title">
            <div class="chapter-inner"><div class="chapter-heading"><span class="section-number">03 / Những thứ tôi tạo ra</span><h2 id="projects-title">Selected<br /><em>work.</em></h2></div>
                <div class="project-list">{projects.map((project,index) => <a class="project-row" href={'/projects/' + project.id + '/'}><span class="project-order">0{index+1}</span><strong>{project.data.title}</strong><span class="project-summary">{project.data.summary}</span><span class="project-arrow">↗</span></a>)}</div>
                <p class="sample-note">Dự án mẫu — thay nội dung trong GitHub.</p>
            </div>
        </section>
        <section id="journeys" class="chapter journeys-chapter" aria-labelledby="journeys-title">
            <div class="chapter-inner"><span class="section-number">04 / Ngoài màn hình</span><h2 id="journeys-title">Đi xa<br /><em>để nhìn gần.</em></h2><p>Mỗi nơi có một nhịp sống. Mỗi chuyến đi để lại một góc nhìn mới.</p>
                <div class="destination-list">{destinations.map((place) => <a href={'/places/' + place.id + '/'} class="destination-link"><Image src={place.data.cover} alt={place.data.coverAlt} widths={[480,960]} sizes="(max-width: 800px) 90vw, 45vw" loading="lazy" /><span><small>Điểm đến / 01</small><strong>{place.data.title}</strong><b>Khám phá ↗</b></span></a>)}</div>
                <p class="sample-note">Địa điểm mẫu — thay ảnh và câu chuyện trong GitHub.</p>
            </div>
        </section>
        <section id="journal" class="chapter journal-chapter" aria-labelledby="journal-title">
            <div class="chapter-inner"><span class="section-number">05 / Nhật ký</span><h2 id="journal-title">Stories<br /><em>to tell.</em></h2><div class="journal-list">{posts.slice(0,3).map((post,index) => <a href={'/journal/' + post.id + '/'}><span>0{index+1}</span><strong>{post.data.title}</strong><span>{post.data.category.replace('-', ' ')}</span><b>↗</b></a>)}</div><a class="text-link" href="/journal/">Đọc tất cả bài viết ↗</a></div>
        </section>
    </main>
    <script>
        if (!matchMedia('(prefers-reduced-motion: reduce), (max-width: 700px)').matches) {
            const start = () => import('../journey/JourneyCanvas').then(({ mountJourney }) => mountJourney(document.querySelector('#journey-canvas')));
            window.addEventListener('load', () => setTimeout(start, 300), { once: true });
        }
    </script>
</BaseLayout>
