---
import BaseLayout from '../layouts/BaseLayout.astro';
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import profile from '../data/profile.json';
import '../styles/experience.css';

const projects = await getCollection('projects');
const destinations = await getCollection('destinations');
const posts = (await getCollection('posts')).sort(
    (a, b) => Number(b.data.featured) - Number(a.data.featured) || b.data.date.valueOf() - a.data.date.valueOf(),
);
const displayName = profile.shortName === 'YOUR NAME' ? 'HELLO.' : profile.shortName;
const [firstName, ...restParts] = displayName.trim().split(/\s+/);
const restName = restParts.join(' ');
---
<BaseLayout title="Portfolio × Journal">
    <main id="main" class="home">
        <div class="journey-backdrop" aria-hidden="true"><div class="cosmos-layer"></div><div class="nature-layer"></div><div class="paper-layer"></div></div>
        <section id="person" class="chapter hero-chapter" aria-labelledby="hero-title">
            {profile.portrait && <picture class="hero-portrait">
                <source media="(max-aspect-ratio: 3 / 4)" srcset={profile.portraitMobile} />
                <source media="(max-aspect-ratio: 3 / 2)" srcset={profile.portraitTablet} />
                <source media="(min-aspect-ratio: 2 / 1)" srcset={profile.portraitUltrawide} />
                <source media="(min-aspect-ratio: 3 / 2)" srcset={profile.portraitWide} />
                <img src={profile.portrait} alt={profile.portraitAlt} fetchpriority="high" decoding="async" />
            </picture>}
            <div class="chapter-inner hero-inner">
                <div class="hero-topline"><span>01 / Departure</span><span>{profile.location} → anywhere</span></div>
                <p class="hero-kicker">Portfolio / Field notes<br />One person, many journeys</p>
                <h1 id="hero-title">
                    <span class="hero-name-first">{firstName}</span>
                    {restName && <span class="hero-name-rest">{restName}</span>}
                </h1>
                <div class="hero-bottomline"><p>{profile.intro}</p><a href="#projects" class="scroll-arrow" aria-label="Scroll to projects">↓</a><span>Scroll to move through the chapters<br />Click any stop to explore</span></div>
            </div>
        </section>
        <section class="chapter about-chapter" aria-labelledby="about-title">
            <div class="chapter-inner about-inner"><span class="section-number">02 / About</span><h2 id="about-title">Two worlds.<br /><em>One storyteller.</em></h2><p>Between lines of code and unfamiliar roads — I care about keeping the whole process, not just the finished frame.</p></div>
        </section>
        <section id="projects" class="chapter projects-chapter" aria-labelledby="projects-title">
            <div class="chapter-inner"><div class="chapter-heading"><span class="section-number">03 / Selected work</span><h2 id="projects-title">Made<br /><em>of curiosity.</em></h2></div>
                <div class="project-list">{projects.map((project, index) => <a class="project-row" href={'/projects/' + project.id + '/'}><span class="project-order">0{index + 1}</span><strong>{project.data.title}</strong><span class="project-summary">{project.data.summary}</span><span class="project-arrow">↗</span><Image class="project-preview" src={project.data.cover} alt={project.data.coverAlt} widths={[480, 960]} sizes="(max-width: 800px) 100vw, 35vw" loading="lazy" /></a>)}</div>
            </div>
        </section>
        <section id="journeys" class="chapter journeys-chapter" aria-labelledby="journeys-title">
            <div class="chapter-inner"><span class="section-number">04 / Beyond the screen</span><h2 id="journeys-title">Beyond<br /><em>coordinates.</em></h2><p>Walking through a place is watching it shift with the light, the people, and the memories you carry home.</p>
                <div class="destination-list">{destinations.map((place, index) => <a href={'/places/' + place.id + '/'} class="destination-link"><Image src={place.data.cover} alt={place.data.coverAlt} widths={[640, 960, 1440]} sizes="(max-width: 800px) 100vw, 84vw" loading="lazy" /><span><small>Destination / 0{index + 1}</small><strong>{place.data.title}</strong><b>Explore ↗</b></span></a>)}</div>
            </div>
        </section>
        <section id="journal" class="chapter journal-chapter" aria-labelledby="journal-title">
            <div class="chapter-inner"><span class="section-number">05 / Journal</span><h2 id="journal-title">Field<br /><em>notes.</em></h2><div class="journal-list">{posts.slice(0, 3).map((post, index) => <a href={'/journal/' + post.id + '/'}><span>0{index + 1}</span><strong>{post.data.title}</strong><span>{post.data.category} · {post.data.date.getUTCFullYear()}</span><b>↗</b></a>)}</div><a class="text-link" href="/journal/">Read all stories ↗</a></div>
        </section>
    </main>
    <script>
        import { getNatureBlend } from '../journey/scrollProgress.js';
        const home = document.querySelector<HTMLElement>('.home');
        const portrait = document.querySelector<HTMLElement>('.hero-portrait');
        const cosmos = document.querySelector<HTMLElement>('.cosmos-layer');
        const nature = document.querySelector<HTMLElement>('.nature-layer');
        const paper = document.querySelector<HTMLElement>('.paper-layer');
        const about = document.querySelector<HTMLElement>('.about-chapter');
        const journeys = document.querySelector<HTMLElement>('#journeys');
        const journal = document.querySelector<HTMLElement>('#journal');
        let blend = 0;
        let scheduled = false;
        const update = () => {
            scheduled = false;
            if (!home || !cosmos || !nature || !paper || !about || !journeys || !journal) return;
            const portraitBlend = portrait
                ? getNatureBlend(about.getBoundingClientRect().top, innerHeight)
                : 1;
            blend = getNatureBlend(journeys.getBoundingClientRect().top, innerHeight);
            const paperBlend = getNatureBlend(journal.getBoundingClientRect().top, innerHeight);
            if (portrait) {
                portrait.style.opacity = String((1 - portraitBlend) * (1 - paperBlend));
            }
            cosmos.style.opacity = String(portraitBlend * (1 - blend) * (1 - paperBlend));
            nature.style.opacity = String(blend * (1 - paperBlend));
            paper.style.opacity = String(paperBlend);
            if (!matchMedia('(prefers-reduced-motion: reduce)').matches) {
                cosmos.style.transform = `scale(1.12) translate3d(0,${Math.min(scrollY * -0.035, 0)}px,0)`;
                nature.style.transform = `scale(1.08) translate3d(0,${Math.max(-90, (journeys.getBoundingClientRect().top - innerHeight) * 0.035)}px,0)`;
            }
        };
        const queueUpdate = () => {
            if (scheduled) return;
            scheduled = true;
            requestAnimationFrame(update);
        };
        home?.classList.add('journey-active');
        addEventListener('scroll', queueUpdate, { passive: true });
        addEventListener('resize', queueUpdate, { passive: true });
        addEventListener('pageshow', queueUpdate);
        update();
    </script>
</BaseLayout>
