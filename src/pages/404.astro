---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout
    title="Page not found"
    description="The page you're looking for doesn't exist or has moved."
    theme="night"
    noIndex={true}
>
    <main id="main" class="not-found-page">
        <div class="not-found-inner">
            <span class="section-number" data-vi="404 / Không tìm thấy trang">404 / Page not found</span>
            <h1 data-vi-html="Lạc khỏi<br /><em>khung hình.</em>">Out of<br /><em>frame.</em></h1>
            <p data-vi="Đường dẫn này không tồn tại — hoặc bài viết đã được chuyển sang địa chỉ khác.">This link doesn't lead anywhere — or the page has moved to a new address.</p>
            <div class="not-found-links">
                <a class="text-link" href="/" data-vi="← Về trang chủ" data-vi-href="/vi/">← Back home</a>
                <a class="text-link" href="/journal/" data-vi="Đọc nhật ký ↗" data-vi-href="/vi/journal/">Read the journal ↗</a>
            </div>
        </div>
    </main>
    <script is:inline>
        (() => {
            try {
                const saved = localStorage.getItem('preferred-lang');
                const langs = navigator.languages && navigator.languages.length ? navigator.languages : [navigator.language || 'en'];
                const isVi = saved === 'vi' || (!saved && langs.some((l) => String(l).toLowerCase().startsWith('vi')));
                if (!isVi) return;
                document.documentElement.lang = 'vi';
                document.querySelectorAll('[data-vi]').forEach((el) => {
                    const txt = el.getAttribute('data-vi');
                    if (txt !== null) el.textContent = txt;
                });
                document.querySelectorAll('[data-vi-html]').forEach((el) => {
                    const html = el.getAttribute('data-vi-html');
                    if (html !== null) el.innerHTML = html;
                });
                document.querySelectorAll('[data-vi-href]').forEach((el) => {
                    const href = el.getAttribute('data-vi-href');
                    if (href !== null) el.setAttribute('href', href);
                });
            } catch {}
        })();
    </script>
</BaseLayout>
