---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout
    title="Page not found"
    description="The page you're looking for doesn't exist or has moved."
    theme="night"
    noIndex={true}
>
    <main id="main" class="not-found-page">
        <div class="not-found-inner">
            <span class="section-number">404 / Off the map</span>
            <h1>Out of<br /><em>frame.</em></h1>
            <p>This path doesn't lead anywhere — or the story has moved to a new address.</p>
            <div class="not-found-links">
                <a class="text-link" href="/">← Back home</a>
                <a class="text-link" href="/journal/">Read the journal ↗</a>
            </div>
        </div>
    </main>
</BaseLayout>
