---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
const posts = (await getCollection('posts')).sort((a,b) => b.data.date.valueOf() - a.data.date.valueOf());
---
<BaseLayout title="Nhật ký">
    <main id="main" class="archive-page">
        <div class="archive-intro"><span class="section-number">Nhật ký / Bài viết</span><h1>Stories<br /><em>to tell.</em></h1><p>Chuyện về nơi tôi đến, điều tôi làm và những thứ khiến tôi tò mò.</p></div>
        <div class="archive-list">{posts.map((post,index) => <a href={'/journal/' + post.id + '/'}><span>0{index+1}</span><strong>{post.data.title}</strong><span>{post.data.category.replace('-', ' ')}</span><b>↗</b></a>)}</div>
        <p class="sample-note">Bài viết mẫu — bạn có thể thay hoặc thêm bài qua GitHub.</p>
    </main>
</BaseLayout>
