---
import BaseLayout from './BaseLayout.astro';
import { Image } from 'astro:assets';
const { entry, label } = Astro.props;
---
<BaseLayout title={entry.data.title} description={entry.data.summary} theme={entry.data.theme}>
    <main id="main" class="story-page">
        <div class="story-lead">
            <div class="story-meta"><a href="/journal/">← Trở lại bài viết</a><span>{label}</span></div>
            <h1>{entry.data.title}</h1>
            <p>{entry.data.summary}</p>
        </div>
        <figure class="story-cover"><Image src={entry.data.cover} alt={entry.data.coverAlt} widths={[640,960,1600]} sizes="100vw" /><figcaption>{entry.data.coverAlt}</figcaption></figure>
        <article class="story-body"><slot /></article>
        <div class="story-end"><span>Hết câu chuyện, còn hành trình.</span><a href="/journal/">Xem những bài khác ↗</a></div>
    </main>
</BaseLayout>
