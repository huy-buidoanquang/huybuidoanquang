---
import BaseLayout from './BaseLayout.astro';
import { Image } from 'astro:assets';
import { getCollection, type CollectionEntry } from 'astro:content';
import { getLangFromPath, isViId, localizePath, stripEntryLang, ui, type Lang } from '../i18n/ui.js';
import '../styles/story-themes.css';

type AnyStory = CollectionEntry<'posts'> | CollectionEntry<'projects'> | CollectionEntry<'destinations'>;

const { entry, label, lang: propLang } = Astro.props as {
    entry: AnyStory;
    label: string;
    lang?: Lang;
};

const lang: Lang = propLang || getLangFromPath(Astro.url.pathname);
const wantVi = lang === 'vi';
const t = ui[lang];
const style = 'storyStyle' in entry.data ? entry.data.storyStyle : entry.data.theme;
const gallery = 'gallery' in entry.data ? entry.data.gallery : [];
const atmosphere = entry.data.atmosphere || 'none';
const dateLocale = lang === 'vi' ? 'vi-VN' : 'en-US';
const formattedDate = 'dateRange' in entry.data
    ? entry.data.dateRange
    : 'date' in entry.data
        ? new Intl.DateTimeFormat(dateLocale, { month: 'short', day: 'numeric', year: 'numeric', timeZone: 'UTC' }).format(entry.data.date)
        : 'year' in entry.data && entry.data.year
            ? entry.data.year
            : undefined;
const metaLabel = formattedDate ? `${label} · ${formattedDate}` : label;

const telemetry = 'coordinates' in entry.data
    ? {
        region: entry.data.region,
        coordinates: entry.data.coordinates,
        elevation: entry.data.elevation,
        dateRange: entry.data.dateRange,
    }
    : null;

const projectMeta = entry.collection === 'projects'
    ? {
        stack: entry.data.stack,
        role: entry.data.role,
        year: entry.data.year,
        repoUrl: entry.data.repoUrl,
        liveUrl: entry.data.liveUrl,
    }
    : null;

const navBase = t.storyNav[entry.collection];
const backHref = entry.collection === 'posts'
    ? localizePath('/journal/', lang)
    : entry.collection === 'projects'
        ? localizePath('/#projects', lang)
        : localizePath('/#journeys', lang);

// Compute chronological/ordered Previous & Next stories within the same collection + language
let siblings: AnyStory[] = [];
if (entry.collection === 'destinations') {
    siblings = (await getCollection('destinations'))
        .filter((e) => isViId(e.id) === wantVi)
        .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
} else if (entry.collection === 'posts') {
    siblings = (await getCollection('posts'))
        .filter((e) => isViId(e.id) === wantVi)
        .sort((a, b) => Number(b.data.featured) - Number(a.data.featured) || b.data.date.valueOf() - a.data.date.valueOf());
} else {
    siblings = (await getCollection('projects'))
        .filter((e) => isViId(e.id) === wantVi)
        .sort((a, b) => (a.data.order ?? 99) - (b.data.order ?? 99));
}

const currentIdx = siblings.findIndex((s) => s.id === entry.id);
const prevEntry = currentIdx > 0 ? siblings[currentIdx - 1] : null;
const nextEntry = currentIdx >= 0 && currentIdx < siblings.length - 1 ? siblings[currentIdx + 1] : null;

const entryHref = (item: AnyStory) => {
    const slug = stripEntryLang(item.id);
    const prefix = item.collection === 'posts' ? '/journal/' : item.collection === 'projects' ? '/projects/' : '/places/';
    return localizePath(`${prefix}${slug}/`, lang);
};

const entrySub = (item: AnyStory) => {
    if ('region' in item.data) return `${item.data.region} · ${item.data.dateRange}`;
    if ('date' in item.data) return `${t.categories[item.data.category]} · ${item.data.date.getUTCFullYear()}`;
    return item.data.role || item.data.year || t.projectLabel;
};

const darkStyles = new Set(['lantern', 'coastal', 'karst-emerald', 'moss-summit', 'karst-blossom', 'night']);
const pageTheme = darkStyles.has(style) ? 'night' : entry.data.theme;
---
<BaseLayout
    title={entry.data.title}
    description={entry.data.summary}
    theme={pageTheme}
    ogImage={entry.data.cover.src}
    ogType="article"
    lang={lang}
>
    <main id="main" class:list={['story-page', 'story-' + style]}>
        <div
            class="reading-progress"
            role="progressbar"
            aria-label={t.readingProgressAria}
            aria-valuemin="0"
            aria-valuemax="100"
            aria-valuenow="0"
        >
            <span class="reading-progress-fill"></span>
        </div>
        {atmosphere !== 'none' && <canvas class="story-atmosphere" data-atmosphere={atmosphere} aria-hidden="true"></canvas>}
        <div class="story-lead">
            <div class="story-meta"><a href={backHref}>{navBase.backLabel}</a><span>{metaLabel}</span></div>
            <h1>{entry.data.title}</h1>
            <p>{entry.data.summary}</p>
            {telemetry && (
                <dl class="story-telemetry" aria-label={t.telemetryAria}>
                    <div><dt>{t.telemetryRegion}</dt><dd>{telemetry.region}</dd></div>
                    <div><dt>{t.telemetryCoords}</dt><dd>{telemetry.coordinates}</dd></div>
                    {telemetry.elevation && <div><dt>{t.telemetryElevation}</dt><dd>{telemetry.elevation}</dd></div>}
                    <div><dt>{t.telemetryDates}</dt><dd>{telemetry.dateRange}</dd></div>
                </dl>
            )}
            {projectMeta && (projectMeta.stack.length > 0 || projectMeta.repoUrl || projectMeta.liveUrl) && (
                <dl class="story-telemetry project-telemetry" aria-label={t.projectLabel}>
                    {projectMeta.role && <div><dt>{t.projectRole}</dt><dd>{projectMeta.role}</dd></div>}
                    {projectMeta.year && <div><dt>{t.projectYear}</dt><dd>{projectMeta.year}</dd></div>}
                    {projectMeta.stack.length > 0 && (
                        <div>
                            <dt>{t.projectStack}</dt>
                            <dd class="project-stack-list">{projectMeta.stack.join(' · ')}</dd>
                        </div>
                    )}
                    {(projectMeta.repoUrl || projectMeta.liveUrl) && (
                        <div>
                            <dt>{t.projectLinks}</dt>
                            <dd class="project-links-row">
                                {projectMeta.repoUrl && (
                                    <a class="project-link-btn" href={projectMeta.repoUrl} target="_blank" rel="noopener noreferrer">{t.repoLabel}</a>
                                )}
                                {projectMeta.liveUrl && (
                                    <a class="project-link-btn" href={projectMeta.liveUrl} target="_blank" rel="noopener noreferrer">{t.liveDemoLabel}</a>
                                )}
                            </dd>
                        </div>
                    )}
                </dl>
            )}
        </div>
        <figure class="story-cover">
            <div class="photo-3d-frame cover-3d-frame" data-tilt-3d data-tilt-strength="3.5">
                <button
                    type="button"
                    class="photo-trigger"
                    data-photo-src={entry.data.cover.src}
                    data-photo-alt={entry.data.coverAlt}
                    data-photo-caption={entry.data.coverAlt}
                    aria-label={`${t.enlargePhoto}: ${entry.data.coverAlt}`}
                >
                    <Image src={entry.data.cover} alt={entry.data.coverAlt} widths={[640, 1080, 1600]} sizes="100vw" fetchpriority="high" />
                    <span class="photo-glare" aria-hidden="true"></span>
                </button>
            </div>
            <figcaption>
                {entry.data.coverAlt}
                {entry.data.coverCredit && <> · {entry.data.coverCredit}</>}
                {entry.data.coverSource && <> · <a href={entry.data.coverSource} target="_blank" rel="noopener noreferrer">{t.photoSource} ↗</a></>}
            </figcaption>
        </figure>
        <article class="story-body"><slot /></article>
        {gallery.length > 0 && (
            <section class="story-gallery" aria-label={t.galleryAria}>
                <div class="gallery-heading">
                    <span>{t.galleryHeading}</span>
                    <strong>{String(gallery.length).padStart(2, '0')} {t.galleryFrames}</strong>
                </div>
                <div class="gallery-images">
                    {gallery.map((photo, index) => (
                        <figure>
                            <div class="photo-3d-frame" data-tilt-3d data-tilt-strength="5">
                                <button
                                    type="button"
                                    class="photo-trigger"
                                    data-photo-src={photo.src.src}
                                    data-photo-alt={photo.alt}
                                    data-photo-caption={photo.caption || photo.alt}
                                    aria-label={`${t.enlargePhoto}: ${photo.alt}`}
                                >
                                    <Image
                                        src={photo.src}
                                        alt={photo.alt}
                                        widths={[480, 960, 1600]}
                                        sizes="(max-width: 800px) 100vw, 70vw"
                                        loading="lazy"
                                    />
                                    <span class="photo-glare" aria-hidden="true"></span>
                                </button>
                            </div>
                            <figcaption>
                                <span>{String(index + 1).padStart(2, '0')} / {photo.caption || photo.alt}</span>
                                {photo.source && (
                                    <a href={photo.source} target="_blank" rel="noopener noreferrer">
                                        {photo.credit || t.photoSource} ↗
                                    </a>
                                )}
                            </figcaption>
                        </figure>
                    ))}
                </div>
            </section>
        )}
        {(prevEntry || nextEntry) && (
            <nav class="story-pager" aria-label={t.navAria}>
                {prevEntry ? (
                    <a class="story-pager-card" href={entryHref(prevEntry)}>
                        <div class="story-pager-thumb">
                            <Image src={prevEntry.data.cover} alt={prevEntry.data.coverAlt} widths={[320, 640]} sizes="(max-width: 800px) 92vw, 22vw" loading="lazy" />
                        </div>
                        <div class="story-pager-info">
                            <span class="story-pager-dir">{t.prevStoryLabel}</span>
                            <strong>{prevEntry.data.title}</strong>
                            <small>{entrySub(prevEntry)}</small>
                        </div>
                    </a>
                ) : <div class="story-pager-spacer" aria-hidden="true"></div>}
                {nextEntry && (
                    <a class="story-pager-card story-pager-next" href={entryHref(nextEntry)}>
                        <div class="story-pager-thumb">
                            <Image src={nextEntry.data.cover} alt={nextEntry.data.coverAlt} widths={[320, 640]} sizes="(max-width: 800px) 92vw, 22vw" loading="lazy" />
                        </div>
                        <div class="story-pager-info">
                            <span class="story-pager-dir">{t.nextStoryLabel}</span>
                            <strong>{nextEntry.data.title}</strong>
                            <small>{entrySub(nextEntry)}</small>
                        </div>
                    </a>
                )}
            </nav>
        )}
        <div class="story-end">
            <span>{navBase.endText}</span>
            <div class="story-end-actions">
                <button
                    type="button"
                    class="story-share-btn"
                    data-default-label={t.copyLink}
                    data-copied-label={t.linkCopied}
                >
                    {t.copyLink}
                </button>
                <a href={backHref}>{navBase.endLabel}</a>
            </div>
        </div>
    </main>
    <dialog class="photo-dialog" aria-label={t.lightboxAria} data-zoom-prefix={lang === 'vi' ? 'Phóng' : 'Zoom'}>
        <div class="photo-dialog-bg" aria-hidden="true"></div>
        <div class="photo-dialog-bar">
            <span class="photo-counter" aria-live="polite"></span>
            <div class="photo-dialog-actions">
                <button type="button" class="photo-zoom" aria-label={t.lightboxZoomAria}>{t.lightboxZoom}</button>
                <button type="button" class="photo-prev" aria-label={t.lightboxPrevAria}>←</button>
                <button type="button" class="photo-next" aria-label={t.lightboxNextAria}>→</button>
                <button type="button" class="photo-close" aria-label={t.lightboxCloseAria}>{t.lightboxClose}</button>
            </div>
        </div>
        <div class="photo-stage">
            <img class="photo-dialog-img" alt="" draggable="false" />
        </div>
        <p class="photo-dialog-caption"></p>
        <div class="photo-thumbs" role="list" aria-label={t.lightboxJumpAria}></div>
    </dialog>
    <script>
        import { initStoryExperience } from '../journey/StoryAtmosphere3D.ts';

        initStoryExperience();

        // Reading Progress Bar (theme-colored, GPU-composited)
        const progressEl = document.querySelector<HTMLElement>('.reading-progress');
        const progressFill = document.querySelector<HTMLElement>('.reading-progress-fill');
        if (progressEl && progressFill) {
            let ticking = false;
            const updateProgress = () => {
                ticking = false;
                const docH = Math.max(1, document.documentElement.scrollHeight - window.innerHeight);
                const ratio = Math.max(0, Math.min(1, window.scrollY / docH));
                progressFill.style.transform = `scaleX(${ratio.toFixed(4)})`;
                progressEl.setAttribute('aria-valuenow', String(Math.round(ratio * 100)));
            };
            const onScrollProgress = () => {
                if (!ticking) {
                    ticking = true;
                    requestAnimationFrame(updateProgress);
                }
            };
            window.addEventListener('scroll', onScrollProgress, { passive: true });
            window.addEventListener('resize', onScrollProgress, { passive: true });
            updateProgress();
        }

        // Copy Link share button
        const shareBtn = document.querySelector<HTMLButtonElement>('.story-share-btn');
        shareBtn?.addEventListener('click', async () => {
            const defaultLabel = shareBtn.dataset.defaultLabel || 'Copy link';
            const copiedLabel = shareBtn.dataset.copiedLabel || 'Link copied ✓';
            try {
                await navigator.clipboard.writeText(window.location.href);
                shareBtn.textContent = copiedLabel;
                shareBtn.classList.add('is-copied');
                window.setTimeout(() => {
                    shareBtn.textContent = defaultLabel;
                    shareBtn.classList.remove('is-copied');
                }, 2200);
            } catch {
                window.prompt(defaultLabel, window.location.href);
            }
        });

        // Museum Immersive Pan / Zoom / Pinch / Preload Lightbox
        const dialog = document.querySelector<HTMLDialogElement>('.photo-dialog');
        const triggers = [...document.querySelectorAll<HTMLButtonElement>('.photo-trigger')];
        const prevBtn = dialog?.querySelector<HTMLButtonElement>('.photo-prev');
        const nextBtn = dialog?.querySelector<HTMLButtonElement>('.photo-next');
        const zoomBtn = dialog?.querySelector<HTMLButtonElement>('.photo-zoom');
        const counter = dialog?.querySelector<HTMLElement>('.photo-counter');
        const bgEl = dialog?.querySelector<HTMLElement>('.photo-dialog-bg');
        const stage = dialog?.querySelector<HTMLElement>('.photo-stage');
        const imgEl = dialog?.querySelector<HTMLImageElement>('.photo-dialog-img');
        const captionEl = dialog?.querySelector<HTMLElement>('.photo-dialog-caption');
        const thumbsEl = dialog?.querySelector<HTMLElement>('.photo-thumbs');
        const zoomPrefix = dialog?.dataset.zoomPrefix || 'Zoom';

        let active = 0;
        let zoom = 1;
        let panX = 0;
        let panY = 0;
        let dragging = false;
        let dragStartX = 0;
        let dragStartY = 0;
        let touchStartX = 0;
        let pinchStartDist = 0;
        let pinchStartZoom = 1;
        const preloaded = new Set<string>();

        const preloadPhoto = (index: number) => {
            if (triggers.length <= 1) return;
            const norm = (index + triggers.length) % triggers.length;
            const src = triggers[norm]?.dataset.photoSrc;
            if (!src || preloaded.has(src)) return;
            preloaded.add(src);
            const img = new window.Image();
            img.decoding = 'async';
            img.src = src;
        };

        const applyTransform = () => {
            if (!imgEl || !zoomBtn || !stage) return;
            imgEl.style.transform = `translate3d(${panX.toFixed(1)}px, ${panY.toFixed(1)}px, 0) scale(${zoom.toFixed(2)})`;
            zoomBtn.textContent = zoom > 1.05 ? `${zoomPrefix} ${zoom.toFixed(1)}×` : `${zoomPrefix} 1×`;
            stage.classList.toggle('is-zoomed', zoom > 1.05);
        };

        const resetZoom = () => {
            zoom = 1;
            panX = 0;
            panY = 0;
            applyTransform();
        };

        const thumbButtons: HTMLButtonElement[] = [];
        if (thumbsEl && triggers.length > 1) {
            triggers.forEach((trigger, idx) => {
                const btn = document.createElement('button');
                btn.type = 'button';
                btn.className = 'photo-thumb';
                btn.setAttribute('aria-label', `${idx + 1}`);
                const thumbImg = document.createElement('img');
                thumbImg.src = trigger.querySelector('img')?.currentSrc || trigger.dataset.photoSrc || '';
                thumbImg.alt = '';
                thumbImg.loading = 'lazy';
                btn.appendChild(thumbImg);
                btn.addEventListener('click', () => showPhoto(idx));
                thumbsEl.appendChild(btn);
                thumbButtons.push(btn);
            });
        }

        const showPhoto = (index: number) => {
            if (!dialog || !imgEl || !captionEl || triggers.length === 0) return;
            active = (index + triggers.length) % triggers.length;
            const trigger = triggers[active];
            const src = trigger.dataset.photoSrc || '';
            const alt = trigger.dataset.photoAlt || '';
            const cap = trigger.dataset.photoCaption || alt;

            resetZoom();
            imgEl.classList.remove('is-switching');
            void imgEl.offsetWidth;
            imgEl.classList.add('is-switching');
            imgEl.src = src;
            imgEl.alt = alt;
            captionEl.textContent = cap;
            if (bgEl) bgEl.style.backgroundImage = `url("${src}")`;
            if (counter) {
                counter.textContent = `${String(active + 1).padStart(2, '0')} / ${String(triggers.length).padStart(2, '0')}`;
            }
            const multiple = triggers.length > 1;
            if (prevBtn) prevBtn.hidden = !multiple;
            if (nextBtn) nextBtn.hidden = !multiple;
            thumbButtons.forEach((btn, idx) => {
                const isCur = idx === active;
                btn.classList.toggle('is-active', isCur);
                if (isCur) btn.scrollIntoView({ behavior: 'smooth', inline: 'center', block: 'nearest' });
            });
            preloadPhoto(active + 1);
            preloadPhoto(active - 1);
            if (!dialog.open) dialog.showModal();
        };

        const toggleZoom = () => {
            if (zoom > 1.05) {
                resetZoom();
            } else {
                zoom = 2.15;
                panX = 0;
                panY = 0;
                applyTransform();
            }
        };

        triggers.forEach((trigger, index) => trigger.addEventListener('click', () => showPhoto(index)));
        prevBtn?.addEventListener('click', () => showPhoto(active - 1));
        nextBtn?.addEventListener('click', () => showPhoto(active + 1));
        zoomBtn?.addEventListener('click', toggleZoom);
        dialog?.querySelector('.photo-close')?.addEventListener('click', () => dialog.close());

        stage?.addEventListener('dblclick', toggleZoom);
        stage?.addEventListener('wheel', (event) => {
            if (!dialog?.open) return;
            event.preventDefault();
            const nextZoom = Math.max(1, Math.min(3, zoom + (event.deltaY < 0 ? 0.25 : -0.25)));
            zoom = nextZoom;
            if (zoom <= 1.02) { panX = 0; panY = 0; }
            applyTransform();
        }, { passive: false });

        stage?.addEventListener('pointerdown', (event) => {
            if (zoom <= 1.05) return;
            dragging = true;
            dragStartX = event.clientX - panX;
            dragStartY = event.clientY - panY;
            stage.setPointerCapture(event.pointerId);
        });
        stage?.addEventListener('pointermove', (event) => {
            if (!dragging) return;
            panX = event.clientX - dragStartX;
            panY = event.clientY - dragStartY;
            applyTransform();
        });
        stage?.addEventListener('pointerup', () => { dragging = false; });

        const touchDistance = (touches: TouchList) =>
            Math.hypot(touches[0].clientX - touches[1].clientX, touches[0].clientY - touches[1].clientY);

        stage?.addEventListener('touchstart', (e) => {
            if (e.touches.length === 2) {
                pinchStartDist = touchDistance(e.touches);
                pinchStartZoom = zoom;
            } else if (e.touches.length === 1) {
                pinchStartDist = 0;
                touchStartX = e.touches[0].clientX;
            }
        }, { passive: true });
        stage?.addEventListener('touchmove', (e) => {
            if (e.touches.length === 2 && pinchStartDist > 0) {
                e.preventDefault();
                const ratio = touchDistance(e.touches) / pinchStartDist;
                zoom = Math.max(1, Math.min(3, pinchStartZoom * ratio));
                if (zoom <= 1.02) { panX = 0; panY = 0; }
                applyTransform();
            }
        }, { passive: false });
        stage?.addEventListener('touchend', (e) => {
            if (pinchStartDist > 0) {
                if (e.touches.length < 2) pinchStartDist = 0;
                return;
            }
            if (zoom > 1.05 || e.changedTouches.length !== 1) return;
            const dx = e.changedTouches[0].clientX - touchStartX;
            if (Math.abs(dx) > 48) showPhoto(dx < 0 ? active + 1 : active - 1);
        }, { passive: true });

        dialog?.addEventListener('keydown', (event) => {
            if (event.key === 'ArrowRight') showPhoto(active + 1);
            if (event.key === 'ArrowLeft') showPhoto(active - 1);
            if (event.key === '+' || event.key === '=') { zoom = Math.min(3, zoom + 0.35); applyTransform(); }
            if (event.key === '-') { zoom = Math.max(1, zoom - 0.35); if (zoom <= 1.02) resetZoom(); else applyTransform(); }
            if (event.key === '0') resetZoom();
        });
        dialog?.addEventListener('click', (event) => {
            if (event.target === dialog || event.target === stage) dialog.close();
        });
    </script>
</BaseLayout>
