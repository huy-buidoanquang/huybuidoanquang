---
import BaseLayout from './BaseLayout.astro';
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import '../styles/story-themes.css';

const { entry, label } = Astro.props as {
    entry: CollectionEntry<'posts'> | CollectionEntry<'projects'> | CollectionEntry<'destinations'>;
    label: string;
};

const style = 'storyStyle' in entry.data ? entry.data.storyStyle : entry.data.theme;
const gallery = 'gallery' in entry.data ? entry.data.gallery : [];

const navigationByCollection = {
    posts: {
        backHref: '/journal/',
        backLabel: '← Back to journal',
        endText: 'End of the story, not the journey.',
        endHref: '/journal/',
        endLabel: 'Read more stories ↗',
    },
    projects: {
        backHref: '/#projects',
        backLabel: '← Back to projects',
        endText: 'One project shipped, another question waiting.',
        endHref: '/#projects',
        endLabel: 'Explore more projects ↗',
    },
    destinations: {
        backHref: '/#journeys',
        backLabel: '← Back to journeys',
        endText: 'Every place leaves its own light behind.',
        endHref: '/#journeys',
        endLabel: 'Explore more places ↗',
    },
} as const;

const nav = navigationByCollection[entry.collection];
---
<BaseLayout
    title={entry.data.title}
    description={entry.data.summary}
    theme={style === 'lantern' ? 'night' : entry.data.theme}
    ogImage={entry.data.cover.src}
    ogType="article"
>
    <main id="main" class:list={['story-page', 'story-' + style]}>
        <div class="story-lead">
            <div class="story-meta"><a href={nav.backHref}>{nav.backLabel}</a><span>{label}</span></div>
            <h1>{entry.data.title}</h1>
            <p>{entry.data.summary}</p>
        </div>
        <figure class="story-cover">
            <Image src={entry.data.cover} alt={entry.data.coverAlt} widths={[640, 960, 1600]} sizes="100vw" />
            <figcaption>
                {entry.data.coverAlt}
                {entry.data.coverCredit && <> · {entry.data.coverCredit}</>}
                {entry.data.coverSource && <> · <a href={entry.data.coverSource} target="_blank" rel="noopener noreferrer">Photo source ↗</a></>}
            </figcaption>
        </figure>
        <article class="story-body"><slot /></article>
        {gallery.length > 0 && (
            <section class="story-gallery" aria-label="Photo gallery">
                <div class="gallery-heading">
                    <span>Gallery</span>
                    <strong>{String(gallery.length).padStart(2, '0')} frames</strong>
                </div>
                <div class="gallery-images">
                    {gallery.map((photo, index) => (
                        <figure>
                            <button
                                type="button"
                                class="photo-trigger"
                                data-photo-src={photo.src.src}
                                data-photo-alt={photo.alt}
                                data-photo-caption={photo.caption || photo.alt}
                                aria-label={'Enlarge photo: ' + photo.alt}
                            >
                                <Image
                                    src={photo.src}
                                    alt={photo.alt}
                                    widths={[480, 960, 1600]}
                                    sizes="(max-width: 800px) 100vw, 70vw"
                                    loading="lazy"
                                />
                            </button>
                            <figcaption>
                                <span>{String(index + 1).padStart(2, '0')} / {photo.caption || photo.alt}</span>
                                {photo.source && (
                                    <a href={photo.source} target="_blank" rel="noopener noreferrer">
                                        {photo.credit || 'Photo source'} ↗
                                    </a>
                                )}
                            </figcaption>
                        </figure>
                    ))}
                </div>
            </section>
        )}
        <div class="story-end"><span>{nav.endText}</span><a href={nav.endHref}>{nav.endLabel}</a></div>
    </main>
    <dialog class="photo-dialog" aria-label="Photo viewer">
        <div class="photo-dialog-bar">
            <span class="photo-counter" aria-live="polite"></span>
            <div class="photo-dialog-actions">
                <button type="button" class="photo-prev" aria-label="Previous photo">←</button>
                <button type="button" class="photo-next" aria-label="Next photo">→</button>
                <button type="button" class="photo-close" aria-label="Close photo">Close ×</button>
            </div>
        </div>
        <img alt="" />
        <p></p>
    </dialog>
    <script>
        const dialog = document.querySelector<HTMLDialogElement>('.photo-dialog');
        const triggers = [...document.querySelectorAll<HTMLButtonElement>('.photo-trigger')];
        const prevBtn = dialog?.querySelector<HTMLButtonElement>('.photo-prev');
        const nextBtn = dialog?.querySelector<HTMLButtonElement>('.photo-next');
        const counter = dialog?.querySelector<HTMLElement>('.photo-counter');
        let active = 0;

        const showPhoto = (index: number) => {
            if (!dialog || triggers.length === 0) return;
            active = (index + triggers.length) % triggers.length;
            const trigger = triggers[active];
            const image = dialog.querySelector('img');
            const caption = dialog.querySelector('p');
            if (!image || !caption) return;
            image.src = trigger.dataset.photoSrc || '';
            image.alt = trigger.dataset.photoAlt || '';
            caption.textContent = trigger.dataset.photoCaption || image.alt;
            if (counter) {
                counter.textContent = `${String(active + 1).padStart(2, '0')} / ${String(triggers.length).padStart(2, '0')}`;
            }
            const multiple = triggers.length > 1;
            if (prevBtn) prevBtn.hidden = !multiple;
            if (nextBtn) nextBtn.hidden = !multiple;
            if (!dialog.open) dialog.showModal();
        };

        triggers.forEach((trigger, index) => trigger.addEventListener('click', () => showPhoto(index)));
        prevBtn?.addEventListener('click', () => showPhoto(active - 1));
        nextBtn?.addEventListener('click', () => showPhoto(active + 1));
        dialog?.querySelector('.photo-close')?.addEventListener('click', () => dialog.close());
        dialog?.addEventListener('keydown', (event) => {
            if (event.key === 'ArrowRight') showPhoto(active + 1);
            if (event.key === 'ArrowLeft') showPhoto(active - 1);
        });
        dialog?.addEventListener('click', (event) => {
            if (event.target === dialog) dialog.close();
        });
    </script>
</BaseLayout>
