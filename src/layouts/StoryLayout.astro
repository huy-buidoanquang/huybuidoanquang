---
import BaseLayout from './BaseLayout.astro';
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import '../styles/story-themes.css';
const { entry, label } = Astro.props as { entry: CollectionEntry<'posts'> | CollectionEntry<'projects'> | CollectionEntry<'destinations'>; label: string };
const style = 'storyStyle' in entry.data ? entry.data.storyStyle : entry.data.theme;
const gallery = 'gallery' in entry.data ? entry.data.gallery : [];
---
<BaseLayout title={entry.data.title} description={entry.data.summary} theme={style === 'lantern' ? 'night' : entry.data.theme}>
    <main id="main" class:list={['story-page', 'story-' + style]}>
        <div class="story-lead">
            <div class="story-meta"><a href="/journal/">← Trở lại bài viết</a><span>{label}</span></div>
            <h1>{entry.data.title}</h1>
            <p>{entry.data.summary}</p>
        </div>
        <figure class="story-cover"><Image src={entry.data.cover} alt={entry.data.coverAlt} widths={[640,960,1600]} sizes="100vw" /><figcaption>{entry.data.coverAlt}{entry.data.coverCredit && <> · {entry.data.coverCredit}</>}{entry.data.coverSource && <> · <a href={entry.data.coverSource}>Nguồn ảnh ↗</a></>}</figcaption></figure>
        <article class="story-body"><slot /></article>
        {gallery.length > 0 && <section class="story-gallery" aria-label="Bộ ảnh">
            <div class="gallery-heading"><span>Bộ ảnh</span><strong>{String(gallery.length).padStart(2, '0')} khoảnh khắc</strong></div>
            <div class="gallery-images">{gallery.map((photo, index) => <figure>
                <Image src={photo.src} alt={photo.alt} widths={[480,960,1600]} sizes="(max-width: 800px) 100vw, 70vw" loading="lazy" />
                <figcaption><span>{String(index + 1).padStart(2, '0')} / {photo.caption || photo.alt}</span>{photo.source && <a href={photo.source}>{photo.credit || 'Nguồn ảnh'} ↗</a>}</figcaption>
            </figure>)}</div>
        </section>}
        <div class="story-end"><span>Hết câu chuyện, còn hành trình.</span><a href="/journal/">Xem những bài khác ↗</a></div>
    </main>
</BaseLayout>
