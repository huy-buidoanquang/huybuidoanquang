---
import '../styles/global.css';
import '../styles/transitions.css';
import profile from '../data/profile.json';

interface Props {
    title: string;
    description?: string;
    theme?: 'night' | 'sand' | 'forest';
    ogImage?: string;
    ogType?: 'website' | 'article';
    noIndex?: boolean;
}

const {
    title,
    description = profile.intro,
    theme = 'night',
    ogImage = profile.portraitWide || profile.portrait,
    ogType = 'website',
    noIndex = false,
} = Astro.props;

const pageTitle = `${title} · ${profile.name}`;
const canonicalUrl = !noIndex && Astro.site ? new URL(Astro.url.pathname, Astro.site).toString() : undefined;
const ogImageUrl = ogImage && Astro.site ? new URL(ogImage, Astro.site).toString() : ogImage;
---
<!doctype html>
<html lang="en" data-theme={theme}>
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width,initial-scale=1" />
        <meta name="description" content={description} />
        <meta name="theme-color" content="#111725" />
        {noIndex && <meta name="robots" content="noindex" />}
        <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
        {canonicalUrl && <link rel="canonical" href={canonicalUrl} />}
        <meta property="og:site_name" content={profile.name} />
        <meta property="og:type" content={ogType} />
        <meta property="og:title" content={pageTitle} />
        <meta property="og:description" content={description} />
        {canonicalUrl && <meta property="og:url" content={canonicalUrl} />}
        {ogImageUrl && <meta property="og:image" content={ogImageUrl} />}
        <meta name="twitter:card" content="summary_large_image" />
        <meta name="twitter:title" content={pageTitle} />
        <meta name="twitter:description" content={description} />
        {ogImageUrl && <meta name="twitter:image" content={ogImageUrl} />}
        <title>{pageTitle}</title>
    </head>
    <body>
        <a class="skip-link" href="#main">Skip to content</a>
        <div class="site-intro" aria-hidden="true"><div class="intro-greetings"><span>HELLO</span><span>BONJOUR</span><span>XIN CHÀO</span></div></div>
        <header class="site-header">
            <a class="brand" href="/" aria-label="Back to home">{profile.shortName}<span class="brand-dot">.</span></a>
            <nav aria-label="Primary navigation">
                <a href="/#projects">Projects</a>
                <a href="/#journeys">Journeys</a>
                <a href="/journal/">Journal</a>
            </nav>
            <span class="header-index">Portfolio / Journal — 2026</span>
        </header>
        <slot />
        <footer class="site-footer">
            <p>The story is still unfolding.</p>
            <a class="footer-mail" href={'mailto:' + profile.email}>Let's talk ↗</a>
            <div class="footer-bottom">
                <span>© {new Date().getFullYear()} {profile.name}</span>
                <div class="footer-socials">
                    {profile.socials.map((social) => (
                        <a href={social.url} target="_blank" rel="noopener noreferrer">{social.label} ↗</a>
                    ))}
                </div>
                <a href="/">Back to top ↑</a>
            </div>
        </footer>
        <script is:inline>
            (() => {
                const root = document.documentElement;
                let playIntro = false;
                try {
                    playIntro = sessionStorage.getItem('portfolio-intro-seen') !== '1';
                    sessionStorage.setItem('portfolio-intro-seen', '1');
                } catch {}
                if (matchMedia('(prefers-reduced-motion: reduce)').matches) playIntro = false;
                const intro = document.querySelector('.site-intro');
                if (!playIntro || !intro) {
                    root.classList.add('intro-skipped');
                    return;
                }
                root.classList.add('intro-active');
                window.setTimeout(() => {
                    root.classList.remove('intro-active');
                    root.classList.add('intro-skipped');
                }, 1900);
            })();
        </script>
    </body>
</html>
