---
import '../styles/global.css';
import '../styles/transitions.css';
import profile from '../data/profile.json';
const { title, description = profile.intro, theme = 'night' } = Astro.props;
---
<!doctype html>
<html lang="vi" data-theme={theme}>
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width,initial-scale=1" />
        <meta name="description" content={description} />
        <meta name="theme-color" content="#111725" />
        <title>{title} · {profile.name}</title>
    </head>
    <body>
        <a class="skip-link" href="#main">Bỏ qua điều hướng</a>
        <div class="site-intro" aria-hidden="true"><div class="intro-greetings"><span>HELLO</span><span>BONJOUR</span><span>XIN CHÀO</span></div></div>
        <header class="site-header">
            <a class="brand" href="/" aria-label="Về trang chủ">{profile.shortName}<span class="brand-dot">.</span></a>
            <nav aria-label="Điều hướng chính">
                <a href="/#projects">Dự án</a>
                <a href="/#journeys">Chuyến đi</a>
                <a href="/journal/">Bài viết</a>
            </nav>
            <span class="header-index">Portfolio / Journal — 2026</span>
        </header>
        <slot />
        <footer class="site-footer">
            <p>Một câu chuyện vẫn đang tiếp tục.</p>
            <a class="footer-mail" href={'mailto:' + profile.email}>Let's talk ↗</a>
        <div class="footer-bottom">
            <span>© {new Date().getFullYear()} {profile.name}</span>
            <div class="footer-socials">{profile.socials.map((social) => <a href={social.url}>{social.label} ↗</a>)}</div>
            <a href="/">Về đầu trang ↑</a>
        </div>
        </footer>
        <script is:inline>
            (() => {
                const root = document.documentElement;
                let playIntro = false;
                try {
                    playIntro = sessionStorage.getItem('portfolio-intro-seen') !== '1';
                    sessionStorage.setItem('portfolio-intro-seen', '1');
                } catch {}
                if (matchMedia('(prefers-reduced-motion: reduce)').matches) playIntro = false;
                const intro = document.querySelector('.site-intro');
                if (!playIntro || !intro) {
                    root.classList.add('intro-skipped');
                    return;
                }
                root.classList.add('intro-active');
                window.setTimeout(() => {
                    root.classList.remove('intro-active');
                    root.classList.add('intro-skipped');
                }, 1900);
            })();
        </script>
    </body>
</html>
