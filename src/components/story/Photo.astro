---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { getLangFromPath, ui } from '../../i18n/ui.js';

const { src, alt, caption, credit, source, layout = 'wide', frame } = Astro.props as {
    src: ImageMetadata;
    alt: string;
    caption: string;
    credit?: string;
    source?: string;
    layout?: 'wide' | 'portrait' | 'full';
    frame?: string;
};
const t = ui[getLangFromPath(Astro.url.pathname)];
---
<figure class:list={['story-photo', 'photo-' + layout]}>
    <div class="photo-3d-frame" data-tilt-3d data-tilt-strength="5">
        <button
            type="button"
            class="photo-trigger"
            data-photo-src={src.src}
            data-photo-alt={alt}
            data-photo-caption={caption}
            aria-label={`${t.enlargePhoto}: ${alt}`}
        >
            <Image
                src={src}
                alt={alt}
                widths={[640, 960, 1600]}
                sizes={layout === 'portrait' ? '(max-width: 800px) 100vw, 44vw' : '100vw'}
                loading="lazy"
            />
            <span class="photo-glare" aria-hidden="true"></span>
            {frame && <span class="photo-frame-tag" aria-hidden="true">{frame}</span>}
        </button>
    </div>
    <figcaption>
        <span>{caption}</span>
        {source && <a href={source} target="_blank" rel="noopener noreferrer">{credit || t.photoSource} ↗</a>}
    </figcaption>
</figure>
