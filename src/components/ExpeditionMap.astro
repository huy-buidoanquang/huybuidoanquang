---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import { localizePath, stripEntryLang, ui, type Lang } from '../i18n/ui.js';
import {
    parseCoordinates,
    PHU_QUOC_PATH,
    projectVietnam,
    resolvePinCollisions,
    VIETNAM_BOUNDS,
    VIETNAM_MAINLAND_PATH,
} from '../journey/geo.js';

interface Props {
    destinations: CollectionEntry<'destinations'>[];
    lang: Lang;
}

const { destinations, lang } = Astro.props;
const t = ui[lang];

const themeColors: Record<string, string> = {
    coastal: '#ff9c66',
    cloudsea: '#b7d7f4',
    'highland-winter': '#f2be6b',
    'autumn-ridge': '#ff8c7a',
    'karst-emerald': '#7ee3c4',
    'moss-summit': '#9de2a2',
    'karst-blossom': '#f3a6bc',
};

const rawPins = destinations
    .map((entry, idx) => {
        const parsed = parseCoordinates(entry.data.coordinates);
        if (!parsed) return null;
        const pos = projectVietnam(parsed.lat, parsed.lon);
        const slug = stripEntryLang(entry.id);
        return {
            slug,
            index: idx,
            href: localizePath(`/places/${slug}/`, lang),
            title: entry.data.title,
            region: entry.data.region,
            coordinates: entry.data.coordinates,
            elevation: entry.data.elevation || '',
            dateRange: entry.data.dateRange,
            summary: entry.data.summary,
            cover: entry.data.cover,
            coverAlt: entry.data.coverAlt,
            accent: themeColors[entry.data.storyStyle] || '#c8ec81',
            x: pos.x,
            y: pos.y,
        };
    })
    .filter((item): item is NonNullable<typeof item> => item !== null);

const pins = resolvePinCollisions(rawPins, 23);
const routePath = pins
    .map((pin, idx) => `${idx === 0 ? 'M' : 'L'}${pin.px},${pin.py}`)
    .join(' ');

const latLines = [12, 16, 20].map((lat) => ({
    label: `${lat}°${lang === 'vi' ? 'B' : 'N'}`,
    y: projectVietnam(lat, VIETNAM_BOUNDS.lonMin).y,
}));
const lonLines = [104, 108].map((lon) => ({
    label: `${lon}°${lang === 'vi' ? 'Đ' : 'E'}`,
    x: projectVietnam(VIETNAM_BOUNDS.latMin, lon).x,
}));
const firstPin = pins[0];
---
<section class="expedition-map" aria-label={t.mapTitle}>
    <div class="expedition-map-canvas">
        <div class="map-head">
            <span class="map-kicker">{t.mapTitle}</span>
            <span class="map-count">{String(pins.length).padStart(2, '0')} GPS</span>
        </div>
        <svg
            class="vietnam-svg"
            viewBox={`0 0 ${VIETNAM_BOUNDS.width} ${VIETNAM_BOUNDS.height}`}
            role="img"
            aria-label={t.mapTitle}
        >
            <defs>
                <radialGradient id="vn-glow" cx="50%" cy="35%" r="60%">
                    <stop offset="0%" stop-color="#c8ec81" stop-opacity="0.16" />
                    <stop offset="100%" stop-color="#0b181b" stop-opacity="0" />
                </radialGradient>
                <filter id="pin-bloom" x="-80%" y="-80%" width="260%" height="260%">
                    <feGaussianBlur stdDeviation="3.5" result="blur" />
                    <feMerge>
                        <feMergeNode in="blur" />
                        <feMergeNode in="SourceGraphic" />
                    </feMerge>
                </filter>
            </defs>

            <rect width={VIETNAM_BOUNDS.width} height={VIETNAM_BOUNDS.height} fill="url(#vn-glow)" />

            <g class="map-graticule" aria-hidden="true">
                {latLines.map((line) => (
                    <g>
                        <line x1="16" y1={line.y} x2={VIETNAM_BOUNDS.width - 16} y2={line.y} />
                        <text x={VIETNAM_BOUNDS.width - 18} y={line.y - 5} text-anchor="end">{line.label}</text>
                    </g>
                ))}
                {lonLines.map((line) => (
                    <g>
                        <line x1={line.x} y1="16" x2={line.x} y2={VIETNAM_BOUNDS.height - 16} />
                        <text x={line.x + 5} y={VIETNAM_BOUNDS.height - 18}>{line.label}</text>
                    </g>
                ))}
            </g>

            <path class="vn-silhouette-outer" d={VIETNAM_MAINLAND_PATH} />
            <path class="vn-silhouette" d={VIETNAM_MAINLAND_PATH} />
            <path class="vn-silhouette" d={PHU_QUOC_PATH} />

            <g class="map-archipelagos" aria-hidden="true">
                <circle cx="336" cy="285" r="2.2" />
                <circle cx="342" cy="291" r="1.6" />
                <text x="336" y="276" text-anchor="middle">{lang === 'vi' ? 'Hoàng Sa' : 'Hoang Sa'}</text>
                <circle cx="330" cy="520" r="2.2" />
                <circle cx="338" cy="527" r="1.6" />
                <text x="328" y="511" text-anchor="middle">{lang === 'vi' ? 'Trường Sa' : 'Truong Sa'}</text>
            </g>

            <path class="map-route-line" d={routePath} />

            {pins.map((pin, idx) => (
                <a
                    href={pin.href}
                    class:list={['map-pin', idx === 0 && 'is-active']}
                    data-map-pin={pin.slug}
                    style={`--pin-accent: ${pin.accent};`}
                    aria-label={`${pin.title} — ${pin.region} (${pin.coordinates})`}
                >
                    <circle class="pin-pulse" cx={pin.px} cy={pin.py} r="13" />
                    <circle class="pin-ring" cx={pin.px} cy={pin.py} r="7.5" />
                    <circle class="pin-core" cx={pin.px} cy={pin.py} r="4.2" filter="url(#pin-bloom)" />
                    <text
                        class="pin-code"
                        x={pin.px + (pin.px > 240 ? -12 : 12)}
                        y={pin.py + 4}
                        text-anchor={pin.px > 240 ? 'end' : 'start'}
                    >
                        {String(idx + 1).padStart(2, '0')}
                    </text>
                </a>
            ))}
        </svg>
    </div>

    <div class="expedition-map-panel">
        <p class="map-subtitle">{t.mapSubtitle}</p>
        <div class="map-stop-pills" role="tablist" aria-label={t.mapTitle}>
            {pins.map((pin, idx) => (
                <button
                    type="button"
                    role="tab"
                    class:list={['map-stop-pill', idx === 0 && 'is-active']}
                    data-map-select={pin.slug}
                    aria-selected={idx === 0 ? 'true' : 'false'}
                    style={`--pin-accent: ${pin.accent};`}
                >
                    <span>{String(idx + 1).padStart(2, '0')}</span>
                    <strong>{pin.title}</strong>
                </button>
            ))}
        </div>

        <div class="map-preview-cards">
            {pins.map((pin, idx) => (
                <article
                    class:list={['map-preview-card', idx === 0 && 'is-active']}
                    data-map-card={pin.slug}
                    hidden={idx !== 0}
                    style={`--pin-accent: ${pin.accent};`}
                >
                    <a href={pin.href} class="map-preview-media">
                        <Image
                            src={pin.cover}
                            alt={pin.coverAlt}
                            widths={[480, 800]}
                            sizes="(max-width: 960px) 92vw, 42vw"
                            loading="lazy"
                        />
                        <span class="map-preview-coords">{pin.coordinates}</span>
                    </a>
                    <div class="map-preview-body">
                        <small>{pin.region} · {pin.dateRange}{pin.elevation ? ` · ${pin.elevation}` : ''}</small>
                        <h3>{pin.title}</h3>
                        <p>{pin.summary}</p>
                        <a href={pin.href} class="map-preview-cta">{t.stepInside}</a>
                    </div>
                </article>
            ))}
        </div>

        {firstPin && <span class="map-foot-hint">{t.mapExploreHint}</span>}
    </div>
</section>

<script>
    const maps = document.querySelectorAll<HTMLElement>('.expedition-map');
    maps.forEach((root) => {
        const pins = [...root.querySelectorAll<SVGElement>('[data-map-pin]')];
        const pills = [...root.querySelectorAll<HTMLButtonElement>('[data-map-select]')];
        const cards = [...root.querySelectorAll<HTMLElement>('[data-map-card]')];

        const activate = (slug: string) => {
            pins.forEach((el) => el.classList.toggle('is-active', el.getAttribute('data-map-pin') === slug));
            pills.forEach((el) => {
                const active = el.dataset.mapSelect === slug;
                el.classList.toggle('is-active', active);
                el.setAttribute('aria-selected', String(active));
            });
            cards.forEach((el) => {
                const active = el.dataset.mapCard === slug;
                el.classList.toggle('is-active', active);
                el.hidden = !active;
            });
        };

        pins.forEach((pin) => {
            const slug = pin.getAttribute('data-map-pin');
            if (!slug) return;
            pin.addEventListener('pointerenter', () => activate(slug));
            pin.addEventListener('focus', () => activate(slug));
        });

        pills.forEach((pill) => {
            const slug = pill.dataset.mapSelect;
            if (!slug) return;
            pill.addEventListener('click', () => activate(slug));
            pill.addEventListener('pointerenter', () => activate(slug));
        });
    });
</script>
